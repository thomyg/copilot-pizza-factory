<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Microsoft.Playwright" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- Build-order only: the fixture launches the Web app's build output as a real Kestrel
         process, so make sure it's built — but don't reference its assembly. -->
    <ProjectReference Include="..\PizzaFactory.Web\PizzaFactory.Web.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
